# ==============================================================================
# VAIDYA BOTANICALS - Environment Variables
# Copy this file to .env.local for local development. Never commit secrets to git.
# ==============================================================================

PORT=3000
NODE_ENV=development

# 1. SUPABASE (Database, Auth, and Storage)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. ADMIN AUTHENTICATION
# Random 32+ character secrets for session signing and initial admin bootstrap
ADMIN_JWT_SECRET=vaidya_super_secret_jwt_key_change_me_in_production_32chars
ADMIN_BOOTSTRAP_SECRET=vaidya_admin_bootstrap_secret_change_me_998811

# 3. RAZORPAY (Online Payments)
# Found in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere

# 4. WHATSAPP BUSINESS PLATFORM (Cloud API)
# Found in Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
BUSINESS_OWNER_PHONE=+919876543210
