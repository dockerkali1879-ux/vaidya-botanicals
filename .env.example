# ==============================================================================
# VAIDYA BOTANICALS - Environment Variables
# Copy this file to .env.local for local development. Never commit secrets to git.
# ==============================================================================

PORT=3000
NODE_ENV=development

# 1. NEON POSTGRESQL (Singapore - Development Branch)
# Found in Neon Console -> Dashboard -> Connection Details
# Select "Pooled connection" for application runtime:
DATABASE_URL=postgresql://neondb_owner:yourPassword@ep-late-water-b3aruido-pooler.aws-ap-southeast-1.neon.tech/neondb?sslmode=require
# Select "Direct connection" for migrations and DDL:
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:yourPassword@ep-late-water-b3aruido.aws-ap-southeast-1.neon.tech/neondb?sslmode=require

# 2. CLOUDINARY PRODUCT IMAGE STORAGE (Direct Signed Uploads)
# Found in Cloudinary Console -> Dashboard
CLOUDINARY_CLOUD_NAME=vaidya-botanicals
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. 2FACTOR.IN (SMS OTP For Guest Checkout & Administrator Phone Login)
# Found in 2Factor.in Dashboard -> API Keys
TWOFACTOR_API_KEY=your_2factor_api_key
TWOFACTOR_TEMPLATE_NAME=

# 4. ADMINISTRATOR AUTHENTICATION & RESTRICTIONS
# Preconfigured administrator profile ID and E.164 phone number
ADMIN_PROFILE_ID=admin_your_profile_id_here
ADMIN_PHONE_E164=+919999999999
ADMIN_JWT_SECRET=your_32_character_minimum_admin_jwt_secret_here
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret_here

# 5. RAZORPAY (Online Payments - Disabled for Initial Launch)
# Found in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere

# 6. WHATSAPP BUSINESS PLATFORM (Cloud API)
# Found in Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
BUSINESS_OWNER_PHONE=+919999999999
