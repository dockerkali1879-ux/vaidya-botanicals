{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin-gate"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin-gate"
    },
    {
      "source": "/private-login",
      "destination": "/private-login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
